COMPOSIO_API_KEY=your-composio-key
COMPOSIO_USER_ID=revops
SLACK_CHANNEL=#inbound-leads
# The time you start the agent, in UTC, so older contacts are skipped
# Print it with: date -u +%Y-%m-%dT%H:%M:%S+00:00
RESEARCH_SINCE=YYYY-MM-DDTHH:MM:SS+00:00
BRIGHTDATA_API_TOKEN=your-bright-data-token
BRIGHTDATA_SERP_ZONE=serp_api
BRIGHTDATA_UNLOCKER_ZONE=web_unlocker
BRIGHTDATA_DATASET_SEARCH=off
AGENT_SEARCH=off
ANTHROPIC_API_KEY=your-anthropic-key
CLAUDE_MODEL=claude-opus-5-5
